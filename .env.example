# ==============================================================================
# ML-CaPsule — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in the root directory and fill in your actual credentials.
# NEVER commit your '.env' file or hardcode secret keys in notebooks or scripts!
# ==============================================================================

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI API ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here

# --- Hugging Face ---
HF_TOKEN=your_huggingface_token_here

# --- Kaggle API Credentials ---
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here
KAGGLE_API_TOKEN=your_kaggle_api_token_here
KAGGLE_DATASET_HANDLE=varshithnagubandi/flood-prediction

# --- Roboflow API ---
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# --- OpenWeatherMap API ---
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# --- Cloudinary API ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# --- TMDB (The Movie Database) API ---
TMDB_API_KEY=your_tmdb_api_key_here

# --- YouTube Data API ---
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Twitter / X API ---
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# --- GitHub API ---
GITHUB_ACCESS_TOKEN=your_github_access_token_here

# --- Firebase API ---
FIREBASE_API_KEY=your_firebase_api_key_here

# --- VirusTotal API ---
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# --- Application Secret Keys ---
SECRET_KEY=your_application_secret_key_here
